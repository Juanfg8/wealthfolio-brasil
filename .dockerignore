# Ignore VCS and local tooling metadata
.git
.gitignore
.env*

# Node workspace artifacts
node_modules
**/node_modules
dist
.vite
.next
.turbo

# Rust build outputs
target
**/target

# Test/output artifacts
coverage
test-results
playwright-report

# Generated assets and caches
*.tsbuildinfo
*.log
*.sqlite
db
tmp

# Local database snapshots and working data at the repository root. The
# frontend stage does `COPY . .`, so without these the operator's real
# portfolio lands in a build layer. Root-anchored on purpose: test fixtures
# under crates/ are still needed by the build.
*.db
*.db-wal
*.db-shm
*.db.lock
*.xlsx
backups

# OS/editor files
.DS_Store
Thumbs.db

# Generated native projects are not used by the web image
apps/tauri/gen
